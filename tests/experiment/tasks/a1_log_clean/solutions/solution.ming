// A1 日志清洗 — 参考实现(Ming)
// 行判定:段数>=5 且第 2 段恰为四级别之一且含 user=/action= 段;
// 保留 INFO/WARN/ERROR,输出 "user action",末行四级别汇总。
use std.fs;

// 污值整段等值:starts_with + char_len(污值代数 clean 面,无洗白)
fn exact_level(level: Untrusted[str], name: str) -> bool {
    return level.starts_with(name) && level.char_len() == name.char_len();
}

fn has_field(parts: Vec[Untrusted[str]], prefix: str) -> bool {
    for p in parts {
        if p.starts_with(prefix) {
            return true;
        }
    }
    return false;
}

fn field_value(parts: Vec[Untrusted[str]], prefix: str) -> Untrusted[str] {
    for p in parts {
        if p.starts_with(prefix) {
            let segs = p.split("=");
            if segs.len() >= 2 {
                return segs[1];
            }
        }
    }
    return std.unstr.mark("-");
}

fn process(content: Untrusted[str]) with io {
    let lines = content.split("\n");
    let mut n = lines.len();
    if n > 0 && lines[n - 1].is_empty() {
        n = n - 1;
    }
    let mut infos = 0;
    let mut warns = 0;
    let mut errs = 0;
    let mut debugs = 0;
    let mut skipped = 0;
    let mut i = 0;
    while i < n {
        let line = lines[i];
        let parts = line.split(" ");
        if parts.len() >= 5 && has_field(parts, "user=") && has_field(parts, "action=") {
            let lvl = parts[1];
            if exact_level(lvl, "INFO") || exact_level(lvl, "WARN") || exact_level(lvl, "ERROR") || exact_level(lvl, "DEBUG") {
                if exact_level(lvl, "INFO") {
                    infos += 1;} else if exact_level(lvl, "WARN") {

                    warns += 1;} else if exact_level(lvl, "ERROR") {

                    errs += 1;} else {

                    debugs += 1;
                }
                if !exact_level(lvl, "DEBUG") {
                    let user = field_value(parts, "user=");
                    let action = field_value(parts, "action=");
                    print(user + " " + action);
                }} else {

                skipped += 1;
            }} else {

            skipped += 1;
        }
        i += 1;
    }
    print("summary INFO=" + str(infos) + " WARN=" + str(warns) + " ERROR=" + str(errs) + " DEBUG=" + str(debugs) + " skipped=" + str(skipped));
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 1 {
        eprint("error: 需要日志文件路径");
        return 1;
    }
    let path = match std.unstr.sanitize_cli_path(args[0]) { Ok(p) => p, Err(_) => { eprint("error: 非法路径参数"); return 1; } };
    match std.fs.read_file(path) {
        Ok(content) => {
            process(content);
            return 0;
        },
        Err(_) => {
            eprint("error: 无法读取 " + path);
            return 1;
        },
    }
}
