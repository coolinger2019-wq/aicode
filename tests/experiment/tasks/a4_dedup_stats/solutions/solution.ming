// A4 去重统计 — 参考实现(Ming)
// chunk_*.txt 名称升序逐块处理;行名过 sanitize_cli_path 作聚合键;
// 插入排序(次数降序、行名升序)取 Top-3。
use std.fs;

fn before(ka: str, ca: i64, kb: str, cb: i64) -> bool {
    if ca != cb {
        return ca > cb;
    }
    return ka < kb;
}

fn sort_pairs(keys: Vec[str], counts: Vec[i64]) -> (Vec[str], Vec[i64]) {
    let mut ks = keys;
    let mut cs = counts;
    let n = ks.len();
    let mut i = 1;
    while i < n {
        let k = ks[i];
        let c = cs[i];
        let mut j = i - 1;
        while j >= 0 && before(k, c, ks[j], cs[j]) {
            ks[j + 1] = ks[j];
            cs[j + 1] = cs[j];
            j -= 1;
        }
        ks[j + 1] = k;
        cs[j + 1] = c;
        i += 1;
    }
    return (ks, cs);
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 1 {
        eprint("error: 需要分块目录");
        return 1;
    }
    let dir = match std.unstr.sanitize_cli_path(args[0]) { Ok(p) => p, Err(_) => { eprint("error: 非法路径参数"); return 1; } };
    let entries = match std.fs.list_dir(dir) { Ok(list) => list, Err(_) => { eprint("error: 无法读取目录 " + dir); return 1; } };
    let mut names: Vec[str] = [];
    for e in entries {
        match std.unstr.sanitize_cli_path(e) {
            Ok(n) => {
                if n.starts_with("chunk_") && n.ends_with(".txt") {
                    names.push(n);
                }
            },
            Err(_) => {
            },
        }
    }
    names.sort();
    let mut counts: Map[str, i64] = {};
    let mut total = 0;
    for name in names {
        match std.fs.read_file(dir + "/" + name) {
            Ok(content) => {
                let lines = content.split("\n");
                let mut m = lines.len();
                if m > 0 && lines[m - 1].is_empty() {
                    m = m - 1;
                }
                let mut j = 0;
                while j < m {
                    match std.unstr.sanitize_cli_path(lines[j]) {
                        Ok(key) => {
                            counts.set(key, counts.get(key).unwrap_or(0) + 1);
                            total += 1;
                        },
                        Err(_) => {
                            eprint("error: 行内容含非法字符 " + name);
                            return 1;
                        },
                    }
                    j += 1;
                }
            },
            Err(_) => {
                eprint("error: 无法读取 " + name);
                return 1;
            },
        }
    }
    let mut keys: Vec[str] = [];
    let mut arr: Vec[i64] = [];
    for (k, v) in counts {
        keys.push(k);
        arr.push(v);
    }
    let (ks, cs) = sort_pairs(keys, arr);
    let mut repeated = 0;
    for c in cs {
        if c > 1 {
            repeated += 1;
        }
    }
    print("total=" + str(total));
    print("unique=" + str(counts.len()));
    print("repeated=" + str(repeated));
    let mut t = 0;
    while t < 3 && t < ks.len() {
        print("top" + str(t + 1) + " " + ks[t] + " " + str(cs[t]));
        t += 1;
    }
    return 0;
}
