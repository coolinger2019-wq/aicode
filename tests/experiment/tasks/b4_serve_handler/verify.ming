// B4 黑盒验收(Ming):经任务自带 harness.mjs 编排(启动被测服务/请求矩阵/关停),
// stdout(transcript)与 expected 逐字节比对。
// 用法(从仓库根):node bin/ming.js run tests/experiment/tasks/b4_serve_handler/verify.ming [-- 被测程序路径]
use std.fs;

use std.proc;

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs, proc {
    let mut prog = "tests/experiment/tasks/b4_serve_handler/solutions/solution.ming";
    if args.len() >= 1 {
        match std.unstr.sanitize_cli_path(args[0]) {
            Ok(p) => {
                prog = p;
            },
            Err(_) => {
            },
        }
    }
    let expected = match std.fs.read_file("tests/experiment/tasks/b4_serve_handler/expected/expected.txt") { Ok(t) => t, Err(e) => { eprint("verify: 无法读取期望输出: " + e); return 1; } };

    // harness 约定:把实际端口作为最后一个参数追加到 prog_cmd 之后;
    // ming 服务经 node bin/ming.js run <文件> -- <端口> 启动(-- 之后被 CLI 剥离并透传)
    let run = std.proc.exec("node", ["tests/experiment/tasks/b4_serve_handler/harness.mjs", "21241", "node", "bin/ming.js", "run", prog, "--"]);
    match run {
        Ok(r) => {
            let (code, out, _e) = r;
            if code != 0 {
                eprint("FAIL harness exit=" + str(code));
                return 1;
            }
            if out == expected {
                print("PASS");
                return 0;
            }
            eprint("FAIL transcript mismatch actual_len=" + str(out.byte_len()) + " expected_len=" + str(expected.byte_len()));
            return 1;
        },
        Err(e) => {
            eprint("FAIL exec: " + e);
            return 1;
        },
    }
}
