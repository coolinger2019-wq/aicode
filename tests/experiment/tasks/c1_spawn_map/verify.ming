// C1 黑盒验收(Ming):运行被测 .ming 程序(无参数),stdout 与 expected 逐字节比对。
// 用法(从仓库根):node bin/ming.js run tests/experiment/tasks/c1_spawn_map/verify.ming [-- 被测程序路径]
use std.fs;

use std.proc;

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs, proc {
    let mut prog = "tests/experiment/tasks/c1_spawn_map/solutions/solution.ming";
    if args.len() >= 1 {
        match std.unstr.sanitize_cli_path(args[0]) {
            Ok(p) => {
                prog = p;
            },
            Err(_) => {
            },
        }
    }
    let expected = match std.fs.read_file("tests/experiment/tasks/c1_spawn_map/expected/expected.txt") { Ok(t) => t, Err(e) => { eprint("verify: 无法读取期望输出: " + e); return 1; } };
    let run = std.proc.exec("node", ["bin/ming.js", "run", prog]);
    match run {
        Ok(r) => {
            let (code, out, _e) = r;
            if code != 0 {
                eprint("FAIL exit=" + str(code));
                return 1;
            }
            if out == expected {
                print("PASS");
                return 0;
            }
            eprint("FAIL stdout mismatch actual_len=" + str(out.byte_len()) + " expected_len=" + str(expected.byte_len()));
            return 1;
        },
        Err(e) => {
            eprint("FAIL exec: " + e);
            return 1;
        },
    }
}
