// B1 JSON 深合并 — 参考实现(Ming)
// 污点纪律:文档内容是污值;json.parse(污) → Untrusted[Json];投影消费;
// 手写序列化拼串(污+污)后 print 出向透传(stringify 污值是编译错误)。
// 数值语料全为整数:as_num → as i64 → str。
use std.fs;

fn num_text(v: Untrusted[Json]) -> Untrusted[str] {
    let n = v.as_num().unwrap_or(0.0);
    return std.unstr.mark(str(n as i64));
}

fn value_text(v: Untrusted[Json]) -> Untrusted[str] {
    if v.is_null() {
        return std.unstr.mark("null");
    }
    if v.is_bool() {
        match v.as_bool() {
            Some(b) => {
                return std.unstr.mark(str(b));
            },
            None => {
                return std.unstr.mark("null");
            },
        }
    }
    if v.is_num() {
        return num_text(v);
    }
    if v.is_str() {
        match v.as_str() {
            Some(s) => {
                return "\"" + s + "\"";
            },
            None => {
                return std.unstr.mark("null");
            },
        }
    }
    if v.is_arr() {
        match v.as_arr() {
            Some(items) => {
                let mut out = std.unstr.mark("[");
                let mut i = 0;
                while i < items.len() {
                    if i > 0 {
                        out = out + ",";
                    }
                    out = out + value_text(items[i]);
                    i += 1;
                }
                return out + "]";
            },
            None => {
                return std.unstr.mark("[]");
            },
        }
    }
    if v.is_obj() {
        match v.as_obj() {
            Some(m) => {
                return obj_text(m);
            },
            None => {
                return std.unstr.mark("{}");
            },
        }
    }
    return std.unstr.mark("null");
}

fn obj_text(m: Map[str, Untrusted[Json]]) -> Untrusted[str] {
    let mut out = std.unstr.mark("{");
    let mut first = true;
    for (k, v) in m {
        if !first {
            out = out + ",";
        }
        first = false;
        out = out + "\"" + k + "\":" + value_text(v);
    }
    return out + "}";
}

fn merge_objs(a: Map[str, Untrusted[Json]], b: Map[str, Untrusted[Json]]) -> Untrusted[str] {
    let mut out = std.unstr.mark("{");
    let mut first = true;
    for (k, av) in a {
        if !first {
            out = out + ",";
        }
        first = false;
        out = out + "\"" + k + "\":";
        if b.has(k) {
            let bv = b.get(k).unwrap();
            if av.is_obj() && bv.is_obj() {
                let am = av.as_obj();
                let bm = bv.as_obj();
                match am {
                    Some(m1) => {
                        match bm {
                            Some(m2) => {
                                out = out + merge_objs(m1, m2);
                            },
                            None => {
                                out = out + value_text(bv);
                            },
                        }
                    },
                    None => {
                        out = out + value_text(bv);
                    },
                }} else {

                out = out + value_text(bv);
            }} else {

            out = out + value_text(av);
        }
    }
    for (k, bv) in b {
        if !a.has(k) {
            if !first {
                out = out + ",";
            }
            first = false;
            out = out + "\"" + k + "\":" + value_text(bv);
        }
    }
    return out + "}";
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 2 {
        eprint("error: 需要 <a.json> <b.json>");
        return 1;
    }
    let pa = match std.unstr.sanitize_cli_path(args[0]) { Ok(p) => p, Err(_) => { eprint("error: 非法路径参数"); return 1; } };
    let pb = match std.unstr.sanitize_cli_path(args[1]) { Ok(p) => p, Err(_) => { eprint("error: 非法路径参数"); return 1; } };
    let ca = match std.fs.read_file(pa) { Ok(t) => t, Err(_) => { eprint("error: 无法读取 " + pa); return 1; } };
    let cb = match std.fs.read_file(pb) { Ok(t) => t, Err(_) => { eprint("error: 无法读取 " + pb); return 1; } };
    let ja = match std.json.parse(ca) { Ok(j) => j, Err(_) => { eprint("error: " + pa + " 不是合法 JSON"); return 1; } };
    let jb = match std.json.parse(cb) { Ok(j) => j, Err(_) => { eprint("error: " + pb + " 不是合法 JSON"); return 1; } };
    if !ja.is_obj() || !jb.is_obj() {
        eprint("error: 顶层必须是对象");
        return 1;
    }
    let ma = match ja.as_obj() { Some(m) => m, None => { eprint("error: 内部错误"); return 1; } };
    let mb = match jb.as_obj() { Some(m) => m, None => { eprint("error: 内部错误"); return 1; } };
    print(merge_objs(ma, mb));
    return 0;
}
