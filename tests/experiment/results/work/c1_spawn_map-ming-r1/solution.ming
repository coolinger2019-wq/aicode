use std.sync;

fn shard(n: i64) -> i64 {
    let lo: i64 = 25 * (n - 1) + 1;
    let hi: i64 = 25 * n;
    let mut s: i64 = 0;
    for i in lo..hi + 1 {
        s = s + i * i;
    }
    s
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, sync {
    let rs: Vec[Result[i64, str]] = sync.spawn_all(shard, [1, 2, 3, 4]);
    let s1: i64 = rs[0].unwrap();
    let s2: i64 = rs[1].unwrap();
    let s3: i64 = rs[2].unwrap();
    let s4: i64 = rs[3].unwrap();
    print("shard1=" + str(s1));
    print("shard2=" + str(s2));
    print("shard3=" + str(s3));
    print("shard4=" + str(s4));
    print("total=" + str(s1 + s2 + s3 + s4));
    0
}
