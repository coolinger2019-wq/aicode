// a2 批量改名:按规则把输入目录文件改名写入输出目录,stdout 打印计划
// 用法: node bin/ming.js run solution.ming -- <输入目录> <输出目录>

fn pad2(v: i64) -> str {
    let s = str(v);
    if v < 10 {
        return "0" + s;
    }
    return s;
}

fn hasTarget(v: Vec[str], k: str) -> bool {
    let mut i = 0;
    while i < v.len() {
        if v[i] == k {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn allDigits(s: str) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s {
        if c < "0" || c > "9" {
            return false;
        }
    }
    return true;
}

fn stripZeros(s: str) -> str {
    let n = s.byte_len();
    let mut i = 0;
    while i < n - 1 && s.slice_chars(i, i + 1) == "0" {
        i = i + 1;
    }
    return s.slice_chars(i, n);
}

fn sortNames(v: Vec[str]) -> Vec[str] {
    let mut a = v;
    let mut i = 1;
    while i < a.len() {
        let key = a[i];
        let mut j = i - 1;
        while j >= 0 && a[j] > key {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return a;
}

fn runWithDirs(inDir: str, outDir: str) -> i64 with io, fs {
    let entries = match std.fs.list_dir(inDir) {
        Ok(v) => v,
        Err(msg) => {
            eprint("error: 输入目录不可读: " + msg);
            return 1;
        }
    };
    let mut names: Vec[str] = [];
    for e in entries {
        match std.unstr.sanitize_cli_path(e) {
            Ok(n) => {
                names.push(n);
            },
            Err(_) => {}
        }
    }
    names = sortNames(names);
    let mut occupied: Vec[str] = [];
    let mut outCreated = false;
    let mut logsCreated = false;
    for name in names {
        let mut kind = 0;
        let mut target = "";
        let n = name.byte_len();
        if n >= 12 {
            if name.starts_with("report_") && name.ends_with(".txt") {
                let mid = name.slice_chars(7, n - 4);
                if allDigits(mid) {
                    let t = stripZeros(mid);
                    let mut ok = true;
                    if t.byte_len() > 19 {
                        ok = false;
                    } else {
                        if t.byte_len() == 19 {
                            if t > "9223372036854775807" {
                                ok = false;
                            }
                        }
                    }
                    if ok {
                        match t.parse_i64() {
                            Ok(v) => {
                                target = "report-" + pad2(v) + ".txt";
                                kind = 1;
                            },
                            Err(_) => {}
                        }
                    }
                }
            }
        }
        if kind == 0 {
            if name.ends_with(".log") {
                target = "logs/" + name;
                kind = 2;
            }
        }
        if kind == 0 {
            print("SKIP " + name + " nomatch");
        } else {
            if hasTarget(occupied, target) {
                print("SKIP " + name + " conflict " + target);
            } else {
                if !outCreated {
                    let _ = std.fs.make_dir(outDir);
                    outCreated = true;
                }
                if kind == 2 {
                    if !logsCreated {
                        let _ = std.fs.make_dir(outDir + "/logs");
                        logsCreated = true;
                    }
                }
                match std.fs.read_bytes(inDir + "/" + name) {
                    Ok(c) => {
                        let _ = std.fs.write_bytes(outDir + "/" + target, c);
                        occupied.push(target);
                        if kind == 1 {
                            print("OK " + name + " -> " + target);
                        } else {
                            print("DIR " + name + " -> " + target);
                        }
                    },
                    Err(_) => {}
                }
            }
        }
    }
    return 0;
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 2 {
        eprint("error: 用法: <输入目录> <输出目录>");
        return 1;
    }
    match std.unstr.sanitize_cli_path(args[0]) {
        Ok(inDir) => {
            match std.unstr.sanitize_cli_path(args[1]) {
                Ok(outDir) => {
                    return runWithDirs(inDir, outDir);
                }
                Err(_) => {
                    eprint("error: 输出目录参数非法");
                    return 1;
                },
            }
        },
        Err(_) => {
            eprint("error: 输入目录参数非法");
            return 1;
        }
    }
}
