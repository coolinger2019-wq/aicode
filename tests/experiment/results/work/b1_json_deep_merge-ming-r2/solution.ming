fn ser(u: Untrusted[Json]) -> Untrusted[str] {
    if u.is_obj() {
        let m = u.as_obj().unwrap();
        let mut out = std.unstr.mark("{");
        let mut first = true;
        for k in m.keys() {
            if first {
                first = false;
            } else {
                out = out + std.unstr.mark(",");
            }
            out = out + std.unstr.mark("\"" + k + "\":");
            out = out + ser(m.get(k).unwrap());
        }
        return out + std.unstr.mark("}");
    }
    if u.is_arr() {
        let v = u.as_arr().unwrap();
        let mut out = std.unstr.mark("[");
        let mut first = true;
        let mut i = 0;
        while i < v.len() {
            if first {
                first = false;
            } else {
                out = out + std.unstr.mark(",");
            }
            out = out + ser(v[i]);
            i = i + 1;
        }
        return out + std.unstr.mark("]");
    }
    if u.is_str() {
        let s = u.as_str().unwrap();
        return std.unstr.mark("\"") + s + std.unstr.mark("\"");
    }
    if u.is_num() {
        let n = u.as_num().unwrap() as i64;
        return std.unstr.mark(str(n));
    }
    if u.is_bool() {
        if u.as_bool().unwrap() {
            return std.unstr.mark("true");
        }
        return std.unstr.mark("false");
    }
    return std.unstr.mark("null");
}

fn merge_ser(a: Untrusted[Json], b: Untrusted[Json]) -> Untrusted[str] {
    let ma = a.as_obj().unwrap();
    let mb = b.as_obj().unwrap();
    let mut out = std.unstr.mark("{");
    let mut first = true;
    for k in ma.keys() {
        if first {
            first = false;
        } else {
            out = out + std.unstr.mark(",");
        }
        out = out + std.unstr.mark("\"" + k + "\":");
        if mb.has(k) {
            let av = ma.get(k).unwrap();
            let bv = mb.get(k).unwrap();
            if av.is_obj() && bv.is_obj() {
                out = out + merge_ser(av, bv);
            } else {
                out = out + ser(bv);
            }
        } else {
            out = out + ser(ma.get(k).unwrap());
        }
    }
    for k in mb.keys() {
        if !ma.has(k) {
            if first {
                first = false;
            } else {
                out = out + std.unstr.mark(",");
            }
            out = out + std.unstr.mark("\"" + k + "\":");
            out = out + ser(mb.get(k).unwrap());
        }
    }
    return out + std.unstr.mark("}");
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 2 {
        eprint("error: expected 2 arguments: <a.json> <b.json>");
        return 1;
    }
    let pa = std.unstr.sanitize_cli_path(args[0]);
    if pa.is_err() {
        eprint("error: invalid path for document A");
        return 1;
    }
    let pb = std.unstr.sanitize_cli_path(args[1]);
    if pb.is_err() {
        eprint("error: invalid path for document B");
        return 1;
    }
    let ra = std.fs.read_file(pa.unwrap());
    if ra.is_err() {
        eprint("error: cannot read document A");
        return 1;
    }
    let rb = std.fs.read_file(pb.unwrap());
    if rb.is_err() {
        eprint("error: cannot read document B");
        return 1;
    }
    let ja = std.json.parse(ra.unwrap());
    if ja.is_err() {
        eprint("error: invalid JSON in document A");
        return 1;
    }
    let jb = std.json.parse(rb.unwrap());
    if jb.is_err() {
        eprint("error: invalid JSON in document B");
        return 1;
    }
    let va = ja.unwrap();
    let vb = jb.unwrap();
    if !va.is_obj() {
        eprint("error: top level of document A is not an object");
        return 1;
    }
    if !vb.is_obj() {
        eprint("error: top level of document B is not an object");
        return 1;
    }
    print(merge_ser(va, vb));
    return 0;
}
