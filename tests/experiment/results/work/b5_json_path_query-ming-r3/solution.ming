use std.fs;
use std.json;
use std.unstr;

fn rjson(v: Untrusted[Json]) -> Untrusted[str] {
    let t: Untrusted[str] = unstr.mark("");
    if v.is_arr() {
        let items = v.as_arr().unwrap();
        let mut acc: Untrusted[str] = t + "[";
        let mut first: bool = true;
        for it in items {
            if first {
                first = false;
            } else {
                acc = acc + ",";
            }
            acc = acc + rjson(it);
        }
        return acc + "]";
    } else if v.is_obj() {
        let m = v.as_obj().unwrap();
        let ks = m.keys();
        let mut acc: Untrusted[str] = t + "{";
        let mut first: bool = true;
        for k in ks {
            if first {
                first = false;
            } else {
                acc = acc + ",";
            }
            acc = acc + "\"" + k + "\":";
            acc = acc + rjson(m.get(k).unwrap());
        }
        return acc + "}";
    } else if v.is_str() {
        return t + "\"" + v.as_str().unwrap() + "\"";
    } else if v.is_num() {
        return t + str((v.as_num().unwrap()) as i64);
    } else if v.is_bool() {
        return t + str(v.as_bool().unwrap());
    } else {
        return t + "null";
    }
}

fn drill(root: Untrusted[Json], segs: Vec[Untrusted[str]]) -> Option[Untrusted[Json]] {
    let mut cur: Untrusted[Json] = root;
    for seg in segs {
        if seg.is_digit() {
            if cur.is_arr() {
                let pr = seg.parse_i64();
                if pr.is_ok() {
                    let o = cur.at(pr.unwrap());
                    if o.is_some() {
                        cur = o.unwrap();
                    } else {
                        return None;
                    }
                } else {
                    return None;
                }
            } else {
                return None;
            }
        } else {
            if cur.is_obj() {
                let sk = unstr.sanitize_cli_path(seg);
                if sk.is_ok() {
                    let o2 = cur.get(sk.unwrap());
                    if o2.is_some() {
                        cur = o2.unwrap();
                    } else {
                        return None;
                    }
                } else {
                    return None;
                }
            } else {
                return None;
            }
        }
    }
    return Some(cur);
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 2 {
        eprint("error: usage: solution.ming <doc.json> <queries.txt>");
        return 1;
    }
    let dpr = unstr.sanitize_cli_path(args[0]);
    if !dpr.is_ok() {
        eprint("error: invalid document path");
        return 1;
    }
    let qpr = unstr.sanitize_cli_path(args[1]);
    if !qpr.is_ok() {
        eprint("error: invalid query path");
        return 1;
    }
    let dfr = fs.read_file(dpr.unwrap());
    if !dfr.is_ok() {
        eprint("error: cannot read document file");
        return 1;
    }
    let qfr = fs.read_file(qpr.unwrap());
    if !qfr.is_ok() {
        eprint("error: cannot read query file");
        return 1;
    }
    let parsed = json.parse(dfr.unwrap());
    if !parsed.is_ok() {
        eprint("error: invalid json document");
        return 1;
    }
    let root = parsed.unwrap();
    if !root.is_obj() {
        eprint("error: document top level is not an object");
        return 1;
    }
    let lines = qfr.unwrap().split("\n");
    let mut n: i64 = lines.len();
    if n > 0 {
        if lines[n - 1].is_empty() {
            n = n - 1;
        }
    }
    let mut found: i64 = 0;
    let mut miss: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let line = lines[i];
        let res = drill(root, line.split("."));
        if res.is_some() {
            let v = res.unwrap();
            let mut out: Untrusted[str] = line + " = ";
            if v.is_str() {
                out = out + v.as_str().unwrap();
            } else if v.is_num() {
                out = out + str((v.as_num().unwrap()) as i64);
            } else if v.is_bool() {
                out = out + str(v.as_bool().unwrap());
            } else if v.is_arr() {
                out = out + rjson(v);
            } else if v.is_obj() {
                out = out + rjson(v);
            } else {
                out = out + "null";
            }
            print(out);
            found = found + 1;
        } else {
            print(line + " = MISSING");
            miss = miss + 1;
        }
        i = i + 1;
    }
    print("found=" + str(found) + " missing=" + str(miss));
    return 0;
}
