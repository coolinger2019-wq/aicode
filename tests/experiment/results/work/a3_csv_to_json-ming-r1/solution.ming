fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 1 {
        eprint("error: missing argument");
        return 1;
    }
    let p = match std.unstr.sanitize_cli_path(args[0]) {
        Ok(s) => s,
        Err(m) => {
            eprint("error: invalid path");
            return 1;
        }
    };
    let content = match std.fs.read_file(p) {
        Ok(t) => t,
        Err(m) => {
            eprint("error: cannot read file");
            return 1;
        }
    };
    let lines = content.split("\n");
    let n = lines.len();
    let mut m = n;
    if n > 0 {
        let last = lines[n - 1];
        if last.is_empty() {
            m = n - 1;
        }
    }
    if m < 1 {
        print(std.unstr.mark("") + "{\"rows\":[],\"errors\":[]}");
        return 0;
    }
    let header = lines[0].split(",");
    let ncols = header.len();
    let mut nrows = 0;
    let mut rows_str = std.unstr.mark("");
    let mut nerr = 0;
    let mut errs_str = "";
    let mut i = 1;
    while i < m {
        let f = lines[i].split(",");
        if f.len() == ncols {
            if nrows > 0 {
                rows_str = rows_str + ",";
            }
            rows_str = rows_str + "{";
            let mut j = 0;
            while j < ncols {
                if j > 0 {
                    rows_str = rows_str + ",";
                }
                rows_str = rows_str + "\"" + header[j] + "\":\"" + f[j] + "\"";
                j = j + 1;
            }
            rows_str = rows_str + "}";
            nrows = nrows + 1;
        } else {
            if nerr > 0 {
                errs_str = errs_str + ",";
            }
            errs_str = errs_str + "{\"line\":" + str(i + 1) + ",\"got\":" + str(f.len()) + ",\"want\":" + str(ncols) + "}";
            nerr = nerr + 1;
        }
        i = i + 1;
    }
    let out = std.unstr.mark("") + "{\"rows\":[" + rows_str + "],\"errors\":[" + errs_str + "]}";
    print(out);
    return 0;
}
