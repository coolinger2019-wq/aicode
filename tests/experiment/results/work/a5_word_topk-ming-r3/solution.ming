use std.unstr;
use std.fs;

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 1 {
        eprint("error: missing file argument");
        return 1;
    }
    let pres = unstr.sanitize_cli_path(args[args.len() - 1]);
    let path = match pres {
        Ok(p) => p,
        Err(_) => {
            eprint("error: invalid file path");
            return 1;
        }
    };
    let rres = fs.read_file(path);
    let content = match rres {
        Ok(c) => c,
        Err(_) => {
            eprint("error: cannot read file");
            return 1;
        }
    };
    let mut words: Vec[str] = [];
    let mut counts: Map[str, i64] = [:];
    let lines = content.split("\n");
    for line in lines {
        let toks = line.split(" ");
        for t in toks {
            if t.is_empty() {
                continue;
            }
            match unstr.sanitize_cli_path(t) {
                Ok(word) => {
                    match counts.get(word) {
                        Some(c) => {
                            counts.set(word, c + 1);
                        }
                        None => {
                            counts.set(word, 1);
                            words.push(word);
                        }
                    }
                }
                Err(_) => { }
            }
        }
    }
    let n = words.len();
    let k = if n < 5 { n } else { 5 };
    let mut used: Vec[bool] = [];
    let mut i = 0;
    while i < n {
        used.push(false);
        i += 1;
    }
    let mut r = 0;
    while r < k {
        let mut found = false;
        let mut bcount = 0;
        let mut bword = "";
        let mut bidx = 0;
        let mut j = 0;
        while j < n {
            if !used[j] {
                let w = words[j];
                let c = counts.get(w).unwrap_or(0);
                let take = if !found {
                    true
                } else {
                    if c > bcount {
                        true
                    } else {
                        if c == bcount { w < bword } else { false }
                    }
                };
                if take {
                    found = true;
                    bcount = c;
                    bword = w;
                    bidx = j;
                }
            }
            j += 1;
        }
        print(bword + " " + str(bcount));
        used[bidx] = true;
        r += 1;
    }
    return 0;
}
