// S4 黑盒验收(Ming):transcript 腿(顺序 23 case + 并发 8×20,经 harness.mjs 编排,B4
// 先例)与 expected 逐字节比对 + 参数级腿(端口 0/65536/非数字 → exit 1、stderr 恰一行
// error: 开头)+ 端口被占腿(harness --occupy)+ 负例腿(交叉喂入 B4 参考实现预期 FAIL/
// expected 变异样本预期 mismatch)。
// 用法(从仓库根):node bin/ming.js run tests/experiment/scenarios/agent_service/verify.ming [-- 被测程序路径]
use std.fs;

use std.proc;

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs, proc {
    let mut prog = "tests/experiment/scenarios/agent_service/solutions/solution.ming";
    if args.len() >= 1 {
        match std.unstr.sanitize_cli_path(args[0]) {
            Ok(p) => {
                prog = p;
            },
            Err(_) => {
            },
        }
    }
    let expected = match std.fs.read_file("tests/experiment/scenarios/agent_service/expected/expected_transcript.txt") { Ok(t) => t, Err(e) => { eprint("verify: 无法读取期望 transcript: " + e); return 1; } };

    // 腿 1:transcript(顺序 + 并发;harness 约定 = 端口作为最后一个参数追加;
    // ming 服务经 node bin/ming.js run <文件> --max-ms 86400000 -- <端口> 启动,N-62.1)
    let run = std.proc.exec("node", ["tests/experiment/scenarios/agent_service/harness.mjs", "21531", "node", "bin/ming.js", "run", prog, "--max-ms", "86400000", "--"]);
    let mut transcript = std.unstr.mark("");
    match run {
        Ok(r) => {
            let (code, out, _e) = r;
            if code != 0 {
                eprint("FAIL transcript 腿 harness exit=" + str(code));
                return 1;
            }
            transcript = out;
            if transcript != expected {
                eprint("FAIL transcript 腿 mismatch actual_len=" + str(transcript.byte_len()) + " expected_len=" + str(expected.byte_len()));
                return 1;
            }
        },
        Err(e) => {
            eprint("FAIL transcript 腿 exec: " + e);
            return 1;
        },
    }

    // 腿 2–4:参数级(端口 0/65536/非数字):exit 1、stdout 空、stderr 恰一行 error: 开头
    if expect_param_error("参数-端口0", exec_ming(prog, "0")) != 0 {
        return 1;
    }
    if expect_param_error("参数-端口65536", exec_ming(prog, "65536")) != 0 {
        return 1;
    }
    if expect_param_error("参数-端口非数字", exec_ming(prog, "abc")) != 0 {
        return 1;
    }

    // 腿 5:端口被占(harness --occupy:持端口 → 起服务 → 绑定失败 → stderr 转发)
    let occ = std.proc.exec("node", ["tests/experiment/scenarios/agent_service/harness.mjs", "--occupy", "21531", "node", "bin/ming.js", "run", prog, "--max-ms", "86400000", "--"]);
    match occ {
        Ok(r) => {
            let (code, _out, err) = r;
            if code != 1 {
                eprint("FAIL 参数-端口被占: exit=" + str(code) + "(预期 1)");
                return 1;
            }
            if !err.starts_with("error:") {
                eprint("FAIL 参数-端口被占: stderr 未以 error: 开头");
                return 1;
            }

            // stderr 恰一行(spec §4 字面)
            let occ_segs = err.split("\n");
            if occ_segs.len() != 2 || !occ_segs.get(1).unwrap().is_empty() {
                eprint("FAIL 参数-端口被占: stderr 非恰一行(段数=" + str(occ_segs.len()) + ")");
                return 1;
            }
        },
        Err(e) => {
            eprint("FAIL 参数-端口被占 exec: " + e);
            return 1;
        },
    }

    // 腿 6:负例-交叉喂入 B4 参考实现(路由不同 → /health 404 ×5 → harness 错服务)
    // → 必须按具体 FAIL 形态失败:exit 3(错服务;排除 no-start exit 2 静默通过,
    // 审查 MINOR-3 收口)
    let cross = std.proc.exec("node", ["tests/experiment/scenarios/agent_service/harness.mjs", "21531", "node", "bin/ming.js", "run", "tests/experiment/tasks/b4_serve_handler/solutions/solution.ming", "--max-ms", "86400000", "--"]);
    match cross {
        Ok(r) => {
            let (c, _o, _e) = r;
            if c != 3 {
                if c == 0 {
                    eprint("FAIL 负例-交叉喂入: B4 参考实现竟通过 S4 验收");} else {

                    eprint("FAIL 负例-交叉喂入: 未按错服务形态失败 exit=" + str(c) + "(预期 3)");
                }
                return 1;
            }
        },
        Err(e) => {
            eprint("FAIL 负例-交叉喂入 exec: " + e);
            return 1;
        },
    }

    // 腿 7:负例-expected 变异样本(改一处标签)→ mismatch FAIL(逐字节比对有齿,S3 惯例;
    // 重跑被测服务产出新 transcript,与变异期望必须不一致)
    let run2 = std.proc.exec("node", ["tests/experiment/scenarios/agent_service/harness.mjs", "21531", "node", "bin/ming.js", "run", prog, "--max-ms", "86400000", "--"]);
    match run2 {
        Ok(r) => {
            let (code2, out2, _e) = r;
            if code2 != 0 {
                eprint("FAIL 负例-变异样本: harness exit=" + str(code2));
                return 1;
            }
            let mutated = expected.replace("code=handler_panic", "code=handler_panicX");
            if out2 != mutated {
                print("PASS");
                return 0;
            }
            eprint("FAIL 负例-变异样本: 变异期望竟与 transcript 一致(比对无齿)");
            return 1;
        },
        Err(e) => {
            eprint("FAIL 负例-变异样本 exec: " + e);
            return 1;
        },
    }
}

fn exec_ming(prog: str, port: str) -> Result[(i64, Untrusted[str], Untrusted[str]), str] with proc {
    return std.proc.exec("node", ["bin/ming.js", "run", prog, "--", port]);
}

fn expect_param_error(tag: str, r: Result[(i64, Untrusted[str], Untrusted[str]), str]) -> i64 with io {
    match r {
        Ok(t) => {
            let (code, out, err) = t;
            if code != 1 {
                eprint("FAIL " + tag + ": exit=" + str(code) + "(预期 1)");
                return 1;
            }
            if !out.is_empty() {
                eprint("FAIL " + tag + ": stdout 非空(预期空)");
                return 1;
            }
            if !err.starts_with("error:") {
                eprint("FAIL " + tag + ": stderr 未以 error: 开头");
                return 1;
            }

            // stderr 恰一行(spec §4 字面):恰一个换行且在末尾 → split 段数 == 2
            let segs = err.split("\n");
            if segs.len() != 2 || !segs.get(1).unwrap().is_empty() {
                eprint("FAIL " + tag + ": stderr 非恰一行(段数=" + str(segs.len()) + ")");
                return 1;
            }
            return 0;
        },
        Err(e) => {
            eprint("FAIL " + tag + ": exec: " + e);
            return 1;
        },
    }
}
