// S2 文件完整性 — 参考实现(Ming)。
// gen:扫描单层目录 .txt 普通文件(字节序升序),内容逐行过 sanitize_cli_path 控制符闸
// (空行以净空串过闸——净化器拒绝空串,但空行不含控制符;任一行 Err → REJECTED),
// 净行 join("\n") 重建净内容 → hmac_sha256(key, cleanContent) → 清单行。
// verify:清单逐行结构校验(损坏 → 参数级错误 exit 1;hex 与重算不符 → TAMPERED 非
// 参数错误),状态行按 name 字节序混排 + 汇总行;全 OK exit 0,否则 exit 1。
use std.crypto;

use std.fs;

use std.re;

fn key_ok(key: str) -> bool {
    return std.re.is_match("^[A-Za-z0-9]+$", key);
}

fn name_pattern_ok(name: str) -> bool {
    return std.re.is_match("^[a-z0-9_-]+\\.txt$", name);
}

fn hex64_ok(hex: str) -> bool {
    return std.re.is_match("^[0-9a-f]{64}$", hex);
}

// 内容控制符闸:Ok = 净内容(净行重建,无损);Err = 任一行含控制符。
// 空行不含控制符:净化器对空串判 Err(非空要求),此处以净空串字面过闸,
// join("\n") 对 LF 文件无损(spec §3 split 保留尾部空段口径)。
fn ctrl_gate(content: Untrusted[str]) -> Result[str, str] {
    let lines = content.split("\n");
    let mut clean: Vec[str] = [];
    for ln in lines {
        if ln.is_empty() {
            clean.push("");} else {

            match std.unstr.sanitize_cli_path(ln) {
                Ok(c) => {
                    clean.push(c);
                },
                Err(_) => {
                    return Err("ctrl-char");
                },
            }
        }
    }
    return Ok(clean.join("\n"));
}

fn run_gen(dir: str, manifest_path: str, key: str) -> i64 with io, fs, crypto {
    if !std.fs.is_dir(dir) {
        eprint("error: 目录不存在 " + dir);
        return 1;
    }
    let entries = match std.fs.list_dir(dir) { Ok(v) => v, Err(e) => { eprint("error: 无法读取目录 " + dir + ": " + e); return 1; } };
    let mut names: Vec[str] = [];
    for e in entries {
        match std.unstr.sanitize_cli_path(e) {
            Err(_) => {
                continue;
            },
            Ok(name) => {
                if name.ends_with(".txt") && !std.fs.is_dir(dir + "/" + name) {
                    names.push(name);
                }
            },
        }
    }
    names.sort();
    let mut lines: Vec[str] = [];
    let mut rejected = 0;
    for name in names {
        let full = dir + "/" + name;
        let content = match std.fs.read_file(full) { Ok(c) => c, Err(_) => { eprint("error: 文件不可读 " + full); return 1; } };
        match ctrl_gate(content) {
            Err(_) => {
                rejected += 1;
            },
            Ok(clean) => {
                lines.push(name + " " + std.crypto.hmac_sha256(key, clean));
            },
        }
    }
    let out = lines.join("\n") + "\n";
    match std.fs.write_file(manifest_path, out) {
        Ok(_) => {
        },
        Err(_) => {
            eprint("error: 无法写入清单 " + manifest_path);
            return 1;
        },
    }
    print("manifest " + str(lines.len()) + " files rejected=" + str(rejected));
    return 0;
}

// 清单解析:结构损坏(不可读/行含控制字符/行格式非法/重复名)→ Err 原因。
// 行 hex 与重算 HMAC 不符不在此列——统一归 TAMPERED(spec §3 步骤 1 口径)。
fn parse_manifest(manifest_path: str) -> Result[Map[str, str], str] with fs {
    let content = match std.fs.read_file(manifest_path) { Ok(c) => c, Err(_) => { return Err("无法读取清单"); } };
    let lines = content.split("\n");
    let mut n = lines.len();
    if n > 0 && lines[n - 1].is_empty() {
        n = n - 1;
    }
    let mut map: Map[str, str] = {};
    let mut i = 0;
    while i < n {
        let clean_line = match std.unstr.sanitize_cli_path(lines[i]) { Ok(c) => c, Err(_) => { return Err("行含控制字符"); } };
        let segs = clean_line.split(" ");
        if segs.len() != 2 || !name_pattern_ok(segs[0]) || !hex64_ok(segs[1]) {
            return Err("行格式非法");
        }
        if map.has(segs[0]) {
            return Err("重复名 " + segs[0]);
        }
        map.set(segs[0], segs[1]);
        i += 1;
    }
    return Ok(map);
}

fn run_verify(dir: str, manifest_path: str, key: str) -> i64 with io, fs, crypto {
    if !std.fs.is_dir(dir) {
        eprint("error: 目录不存在 " + dir);
        return 1;
    }
    let map = match parse_manifest(manifest_path) { Ok(m) => m, Err(why) => { eprint("error: 清单损坏: " + why); return 1; } };
    let mut mnames: Vec[str] = [];
    for (k, _v) in map {
        mnames.push(k);
    }
    mnames.sort();
    let mut ok = 0;
    let mut tampered = 0;
    let mut missing = 0;
    let mut rejected = 0;
    let mut extra = 0;
    let mut out_lines: Vec[str] = [];
    for name in mnames {
        let full = dir + "/" + name;
        if !std.fs.exists(full) {
            missing += 1;
            out_lines.push(name + " MISSING");} else {

            let content = match std.fs.read_file(full) { Ok(c) => c, Err(_) => { eprint("error: 文件不可读 " + full); return 1; } };
            match ctrl_gate(content) {
                Err(_) => {
                    rejected += 1;
                    out_lines.push(name + " REJECTED");
                },
                Ok(clean) => {
                    let hex = std.crypto.hmac_sha256(key, clean);
                    if hex == map.get(name).unwrap() {
                        ok += 1;
                        out_lines.push(name + " OK");} else {

                        tampered += 1;
                        out_lines.push(name + " TAMPERED");
                    }
                },
            }
        }
    }
    let entries = match std.fs.list_dir(dir) { Ok(v) => v, Err(e) => { eprint("error: 无法读取目录 " + dir + ": " + e); return 1; } };
    for e in entries {
        match std.unstr.sanitize_cli_path(e) {
            Err(_) => {
                continue;
            },
            Ok(name) => {
                if name.ends_with(".txt") && !std.fs.is_dir(dir + "/" + name) && !map.has(name) {
                    extra += 1;
                    out_lines.push(name + " EXTRA");
                }
            },
        }
    }
    out_lines.sort();
    for ln in out_lines {
        print(ln);
    }
    print("summary ok=" + str(ok) + " tampered=" + str(tampered) + " missing=" + str(missing) + " rejected=" + str(rejected) + " extra=" + str(extra));
    if tampered + missing + rejected + extra == 0 {
        return 0;
    }
    return 1;
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs, crypto {
    if args.len() < 1 {
        eprint("error: 需要 gen|verify 子命令");
        return 1;
    }
    let sub = match std.unstr.sanitize_cli_path(args[0]) { Ok(s) => s, Err(_) => { eprint("error: 非法子命令"); return 1; } };
    if args.len() < 4 {
        eprint("error: 需要 <dir> <manifest.txt> <key> 三个参数");
        return 1;
    }
    let dir = match std.unstr.sanitize_cli_path(args[1]) { Ok(p) => p, Err(_) => { eprint("error: 非法目录参数"); return 1; } };
    let manifest_path = match std.unstr.sanitize_cli_path(args[2]) { Ok(p) => p, Err(_) => { eprint("error: 非法清单路径参数"); return 1; } };
    let key = match std.unstr.sanitize_cli_path(args[3]) { Ok(k) => k, Err(_) => { eprint("error: 非法 key 参数"); return 1; } };
    if !key_ok(key) {
        eprint("error: key 越值域(仅 [A-Za-z0-9]+)");
        return 1;
    }
    if sub == "gen" {
        return run_gen(dir, manifest_path, key);
    }
    if sub == "verify" {
        return run_verify(dir, manifest_path, key);
    }
    eprint("error: 未知子命令 " + sub);
    return 1;
}
