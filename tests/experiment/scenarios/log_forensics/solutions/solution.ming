// S1 日志取证 — 参考实现(Ming)。
// 行分类(spec §3,逐行):空行→skipped;char_len>4096→overlong;控制符→ctrl-char
// (sanitize_cli_path 行级闸);`{` 开头走 JSON 净域判定,其余文本行按段判定;
// 事件 = WARN/ERROR,非事件 = INFO/DEBUG。报告 = report 头 + E 行(文件序)+
// R 行(文件序);stdout 恰一行摘要。参数级错误 → stderr `error:` + exit 1。
use std.fs;

use std.json;

use std.re;

struct Outcome {
    kind: i64,
    level: str,
    actor: str,
    event: str,
}

fn is_level(s: str) -> bool {
    return s == "INFO" || s == "WARN" || s == "ERROR" || s == "DEBUG";
}

fn domain_ok(s: str) -> bool {
    return std.re.is_match("^[A-Za-z0-9_.-]+$", s);
}

fn outcome_malformed() -> Outcome {
    return Outcome { kind: 0, level: "", actor: "", event: "" };
}

fn outcome_event(lvl: str, act: str, evt: str) -> Outcome {
    return Outcome { kind: 1, level: lvl, actor: act, event: evt };
}

fn outcome_info(lvl: str, act: str, evt: str) -> Outcome {
    return Outcome { kind: 2, level: lvl, actor: act, event: evt };
}

fn json_field(doc: Json, key: str) -> Option[str] {
    match doc.get(key) {
        Some(v) => {
            return v.as_str();
        },
        None => {
            return None;
        },
    }
}

fn classify_json(doc: Json) -> Outcome {
    let lvl = match json_field(doc, "level") { Some(s) => s, None => { return outcome_malformed(); } };
    let act = match json_field(doc, "actor") { Some(s) => s, None => { return outcome_malformed(); } };
    let evt = match json_field(doc, "event") { Some(s) => s, None => { return outcome_malformed(); } };
    if !is_level(lvl) || !domain_ok(act) || !domain_ok(evt) {
        return outcome_malformed();
    }
    if lvl == "WARN" || lvl == "ERROR" {
        return outcome_event(lvl, act, evt);
    }
    return outcome_info(lvl, act, evt);
}

fn classify_text(clean: str) -> Outcome {
    let parts = clean.split(" ");
    if parts.len() < 5 {
        return outcome_malformed();
    }
    let lvl = parts[1];
    let act = parts[2];
    let evt = parts[3];
    if !is_level(lvl) || !domain_ok(act) || !domain_ok(evt) {
        return outcome_malformed();
    }
    if lvl == "WARN" || lvl == "ERROR" {
        return outcome_event(lvl, act, evt);
    }
    return outcome_info(lvl, act, evt);
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 2 {
        eprint("error: 需要 <input.log> <report.txt> 两个参数");
        return 1;
    }
    let in_path = match std.unstr.sanitize_cli_path(args[0]) { Ok(p) => p, Err(_) => { eprint("error: 非法输入路径参数"); return 1; } };
    let out_path = match std.unstr.sanitize_cli_path(args[1]) { Ok(p) => p, Err(_) => { eprint("error: 非法输出路径参数"); return 1; } };
    let content = match std.fs.read_file(in_path) { Ok(t) => t, Err(_) => { eprint("error: 无法读取 " + in_path); return 1; } };
    let lines = content.split("\n");
    let mut n = lines.len();
    if n > 0 && lines[n - 1].is_empty() {
        n = n - 1;
    }
    let mut events = 0;
    let mut rejected = 0;
    let mut info = 0;
    let mut skipped = 0;
    let mut ereport: Vec[str] = [];
    let mut rreport: Vec[str] = [];
    let mut i = 0;
    while i < n {
        let line = lines[i];
        let lineno = i + 1;
        if line.is_empty() {
            skipped += 1;} else if line.char_len() > 4096 {

            rejected += 1;
            rreport.push("R " + str(lineno) + " overlong");} else {

            match std.unstr.sanitize_cli_path(line) {
                Err(_) => {
                    rejected += 1;
                    rreport.push("R " + str(lineno) + " ctrl-char");
                },
                Ok(clean) => {
                    let oc: Outcome = if clean.starts_with("{") { match std.json.parse(clean) { Ok(doc) => classify_json(doc), Err(_) => outcome_malformed() } } else { classify_text(clean) };
                    if oc.kind == 1 {
                        events += 1;
                        ereport.push("E " + str(lineno) + " " + oc.level + " " + oc.actor + " " + oc.event);} else if oc.kind == 2 {

                        info += 1;} else {

                        rejected += 1;
                        rreport.push("R " + str(lineno) + " malformed");
                    }
                },
            }
        }
        i += 1;
    }
    let mut report = "report " + in_path + "\n";
    for e in ereport {
        report = report + e + "\n";
    }
    for r in rreport {
        report = report + r + "\n";
    }
    match std.fs.write_file(out_path, report) {
        Ok(_) => {
        },
        Err(_) => {
            eprint("error: 无法写入报告 " + out_path);
            return 1;
        },
    }
    print("summary events=" + str(events) + " rejected=" + str(rejected) + " info=" + str(info) + " skipped=" + str(skipped) + " total=" + str(n));
    return 0;
}
