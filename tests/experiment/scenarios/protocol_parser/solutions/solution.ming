// S3 协议解析器 — 参考实现(Ming)。
// 管线(spec §2.2):字节层(metadata 门禁 65536 + read_bytes_range 4096 分段计数)
// → 解析层(read_file 整读;无效 UTF-8 → U+FFFD 替换)→ 逐行判定(spec §3,
// 首条命中即停)→ 逐帧状态行 + summary。污值代数:slice_chars/char_len/
// starts_with 清洁面,单字符 hex 解码 = starts_with 16 查表(== 跨污界 M3002,
// 不用等值);解码得净 i64 后大端组装与 Fletcher-16 全在净域。
// 参数级错误 → stderr `error:` 一行 + exit 1(stdout 空);bad > 0 → exit 1。
use std.fs;

const MAX_PAYLOAD: i64 = 4096;

const MAX_INPUT: i64 = 65536;

const CHUNK: i64 = 4096;

struct Verdict {
    code: i64,
    ty: i64,
    flags: i64,
    len: i64,
}

fn verdict(code: i64) -> Verdict {
    return Verdict { code: code, ty: 0, flags: 0, len: 0 };
}

// 单字符 hex 解码(污值代数 clean 谓词查表;非 [0-9a-f] → -1)
fn nib(c: Untrusted[str]) -> i64 {
    if c.starts_with("0") {
        return 0;} else if c.starts_with("1") {
        return 1;} else if c.starts_with("2") {
        return 2;} else if c.starts_with("3") {
        return 3;} else if c.starts_with("4") {
        return 4;} else if c.starts_with("5") {
        return 5;} else if c.starts_with("6") {
        return 6;} else if c.starts_with("7") {
        return 7;} else if c.starts_with("8") {
        return 8;} else if c.starts_with("9") {
        return 9;} else if c.starts_with("a") {
        return 10;} else if c.starts_with("b") {
        return 11;} else if c.starts_with("c") {
        return 12;} else if c.starts_with("d") {
        return 13;} else if c.starts_with("e") {
        return 14;} else if c.starts_with("f") {
        return 15;
    }
    return -1;
}

fn byte_at(line: Untrusted[str], off: i64) -> i64 {
    return nib(line.slice_chars(off, off + 1)) << 4 | nib(line.slice_chars(off + 1, off + 2));
}

// 逐行判定(spec §3;1 BAD_MAGIC/2 BAD_HEX/3 BAD_TYPE/4 BAD_LENGTH/
// 5 TRUNCATED/6 TRAILING/7 CRC_MISMATCH;0 = OK)
fn classify(line: Untrusted[str]) -> Verdict {
    let clen = line.char_len();
    if clen < 16 {
        return verdict(5);
    }
    if !line.slice_chars(0, 4).starts_with("4d47") {
        return verdict(1);
    }
    let mut k = 4;
    while k < clen {
        if nib(line.slice_chars(k, k + 1)) < 0 {
            return verdict(2);
        }
        k += 1;
    }
    let ty = byte_at(line, 4);
    if ty != 1 && ty != 2 && ty != 3 {
        return verdict(3);
    }
    let flags = byte_at(line, 6);
    let b0 = byte_at(line, 8);
    let b1 = byte_at(line, 10);
    let b2 = byte_at(line, 12);
    let b3 = byte_at(line, 14);
    let length = b0 << 24 | b1 << 16 | b2 << 8 | b3;
    if length > MAX_PAYLOAD {
        return verdict(4);
    }
    let expected = 20 + length * 2;
    if clen < expected {
        return verdict(5);
    }
    if clen > expected {
        return verdict(6);
    }

    // 重建帧字节(校验和覆盖域 = type||flags||length||payload),Fletcher-16
    let mut fr: Vec[u8] = [];
    fr.push(ty as u8);
    fr.push(flags as u8);
    fr.push(b0 as u8);
    fr.push(b1 as u8);
    fr.push(b2 as u8);
    fr.push(b3 as u8);
    let mut j = 0;
    while j < length {
        fr.push(byte_at(line, 16 + j * 2) as u8);
        j += 1;
    }
    let mut s1 = 0;
    let mut s2 = 0;
    let mut i = 0;
    while i < fr.len() {
        s1 = (s1 + fr[i] as i64) % 255;
        s2 = (s2 + s1) % 255;
        i += 1;
    }
    let stored = byte_at(line, 16 + length * 2) << 8 | byte_at(line, 16 + length * 2 + 2);
    if (s2 << 8 | s1) != stored {
        return verdict(7);
    }
    return Verdict { code: 0, ty: ty, flags: flags, len: length };
}

fn type_name(ty: i64) -> str {
    if ty == 1 {
        return "DATA";
    }
    if ty == 2 {
        return "CTRL";
    }
    return "KEEPALIVE";
}

fn flags_str(f: i64) -> str {
    let mut names: Vec[str] = [];
    if (f & 1) == 1 {
        names.push("ACK_REQ");
    }
    if (f & 2) == 2 {
        names.push("FRAG");
    }
    if names.len() == 0 {
        return "none";
    }
    return names.join(",");
}

fn status_name(code: i64) -> str {
    if code == 1 {
        return "BAD_MAGIC";} else if code == 2 {
        return "BAD_HEX";} else if code == 3 {
        return "BAD_TYPE";} else if code == 4 {
        return "BAD_LENGTH";} else if code == 5 {
        return "TRUNCATED";} else if code == 6 {
        return "TRAILING";
    }
    return "CRC_MISMATCH";
}

fn main(args: Vec[Untrusted[str]]) -> i64 with io, fs {
    if args.len() < 1 {
        eprint("error: 用法: prog <capture 文件>");
        return 1;
    }
    let in_path = match std.unstr.sanitize_cli_path(args[0]) { Ok(p) => p, Err(_) => { eprint("error: 非法输入路径参数"); return 1; } };
    let m = match std.fs.metadata(in_path) { Ok(x) => x, Err(_) => { eprint("error: 无法读取输入 " + in_path); return 1; } };
    let mut is_file = false;
    match m.get("is_file") {
        Some(b) => {
            match b.as_bool() {
                Some(v) => {
                    is_file = v;
                },
                None => {
                },
            }
        },
        None => {
        },
    }
    if !is_file {
        eprint("error: 输入不是普通文件 " + in_path);
        return 1;
    }
    let mut size: i64 = -1;
    match m.get("size") {
        Some(s) => {
            match s.as_num() {
                Some(f) => {
                    size = f as i64;
                },
                None => {
                },
            }
        },
        None => {
        },
    }
    if size < 0 {
        eprint("error: 无法读取输入大小 " + in_path);
        return 1;
    }
    if size > MAX_INPUT {
        eprint("error: 输入超过大小门禁 (65536): " + str(size));
        return 1;
    }

    // 字节层:4096 分段循环(read_bytes_range 短读合法;计数 = bytes 字段)
    let mut start = 0;
    let mut total = 0;
    while start < size {
        match std.fs.read_bytes_range(in_path, start, CHUNK) {
            Ok(seg) => {
                total += seg.len();
                start += seg.len();
            },
            Err(_) => {
                eprint("error: 分段读取失败 " + in_path);
                return 1;
            },
        }
    }
    let content = match std.fs.read_file(in_path) { Ok(t) => t, Err(_) => { eprint("error: 无法读取输入 " + in_path); return 1; } };
    let lines = content.split("\n");
    let mut n = lines.len();
    if n > 0 && lines[n - 1].is_empty() {
        n = n - 1;
    }
    let mut okc = 0;
    let mut bad = 0;
    let mut blank = 0;
    let mut i = 0;
    while i < n {
        let line = lines[i];
        let lineno = i + 1;
        if line.char_len() == 0 {
            blank += 1;} else {

            let v = classify(line);
            if v.code == 0 {
                okc += 1;
                print("frame " + str(lineno) + " OK type=" + type_name(v.ty) + " flags=" + flags_str(v.flags) + " len=" + str(v.len));} else {

                bad += 1;
                print("frame " + str(lineno) + " " + status_name(v.code));
            }
        }
        i += 1;
    }
    print("summary lines=" + str(n) + " ok=" + str(okc) + " bad=" + str(bad) + " blank=" + str(blank) + " bytes=" + str(total));
    if bad > 0 {
        return 1;
    }
    return 0;
}
