(set-logic QF_LIA)
(set-info :source "Ming 证明义务导出(QF_LIA 子集;规范见 docs/proof-protocol.md)")

; ===== 文件:loop.ming =====
; ---- vc:sum:1 — 索引 i(scope: loop)----
; 方向 low — ming 内部判定: proven(期望 unsat)
(push)
(declare-const n Int)
(declare-const len$buf Int)
(declare-const i$0 Int)
(assert (= n len$buf))
(assert (<= 0 i$0))
(assert (< i$0 n))
(assert (not (>= i$0 0)))
(check-sat)
(pop)
; 方向 high — ming 内部判定: proven(期望 unsat)
(push)
(declare-const n Int)
(declare-const len$buf Int)
(declare-const i$0 Int)
(assert (= n len$buf))
(assert (<= 0 i$0))
(assert (< i$0 n))
(assert (not (< i$0 len$buf)))
(check-sat)
(pop)

(exit)
