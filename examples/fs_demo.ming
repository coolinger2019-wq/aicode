// std.fs:capability 文件系统(v0.6)——所有 fs 操作必须声明效果
use std.fs;

use std.path;

fn main() with io, fs {

    // 写入:write_file 返回 Result[bool, str]
    match std.fs.write_file("demo.txt", "第一行\n第二行\n") {
        Ok(_) => print("写入成功"),
        Err(e) => {
            print("写入失败: \{e}");
            return;
        },
    }

    // 读取:read_file 返回 Result[Untrusted[str], str](v0.77 内容源标污——
    // 文件内容是污值;char_len 是污值代数 clean 面,计数净)
    match std.fs.read_file("demo.txt") {
        Ok(content) => print("读回 \{content.char_len()} 个字符"),
        Err(e) => print("读取失败: \{e}"),
    }

    // 列目录:list_dir 条目 → Vec[Untrusted[str]](路径名标污);
    // 这里只回显不当作路径——拼接 + print 出向透传即可(污值合法回显);
    // 若要拿条目当路径用,先过 std.unstr.sanitize_cli_path(污值直接进
    // path.join/fs.open → M3049)
    match std.fs.list_dir(".") {
        Ok(entries) => {
            for name in entries {
                print("  - " + name);
            }
        },
        Err(e) => print("列目录失败: \{e}"),
    }

    // 路径工具(纯函数,无需效果)
    print(std.path.join("dir", "file.txt"));
    print(std.path.base_name("/tmp/demo.txt"));
    print(std.path.extension("a.tar.gz"));

    // 清理
    let _ = std.fs.remove_file("demo.txt");
    print("存在吗? \{str(std.fs.exists("demo.txt"))}");
}
