// 斐波那契:递归与迭代两种写法;assert_eq 用法
fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fib_loop(n: i64) -> i64 {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i += 1;
    }
    a
}

test fib_small {
    assert_eq(fib(0), 0);
    assert_eq(fib(1), 1);
    assert_eq(fib(10), 55);
    assert_eq(fib_loop(10), 55);
}

fn main() with io {
    for i in 0..11 {
        print("fib(\{i}) = \{fib(i)}");
    }
}
