// tools/batch_rename.ming — 批量重命名(用 Ming 自写;破坏性操作)
//
// v0.51.6 优化:幂等(文件名已带前缀的跳过——重复运行不再前缀叠加)+
// 错误纪律(逐条失败走 stderr,存在失败退出码 1)。
//
// 用法:node bin/ming.js run tools/batch_rename.ming -- <目录> <前缀> [扩展名]
//   (也可用环境变量 RENAME_DIR / RENAME_PREFIX / RENAME_EXT)
// 目录必须显式给出,不再默认 "."。
//
// 工具审计优化(2026-11-27):①同名冲突守卫——fs.rename 落到已存在目标会静默
// 覆盖(实测 a.txt+p_a.txt 双文件变单文件、内容丢失、exit 0),改名前查目标存在
// 即拒绝并计入失败,原文件保留;②扩展名过滤归一化——"txt"/".txt" 同义(此前
// 只有 ".txt" 生效,"txt" 静默零改名 exit 0)。
//
// v0.77 污点迁移(ADR-007):list_dir 条目 → Vec[Untrusted[str]]——每个条目先过
// std.unstr.sanitize_cli_path(校验不改写:拒控制字符,Ok 原样)再作路径/比较串;
// 含控制字符等不可作路径的条目计入失败(错误走 stderr 纪律)。良性路径行为与
// 迁移前逐字节一致。
use std.fs;

use std.path;

// 返回 (成功数, 失败数)
fn batch_rename(dir: str, prefix: str, ext: str, mut count: i64, mut failed: i64) -> (i64, i64) with io, fs {
    match std.fs.list_dir(dir) {
        Ok(entries) => {
            for name in entries {
                match std.unstr.sanitize_cli_path(name) {
                    Ok(clean) => {
                        let is_dir = std.fs.is_dir(std.path.join(dir, clean));

                        // 幂等:已带前缀的跳过
                        let has_prefix = clean.starts_with(prefix);
                        let file_ext = std.path.extension(clean);

                        // 扩展名比较归一化(去前导点,与 main 侧用户输入归一化对称):
                        // extension() 带点返回,"txt"/".txt" 同义
                        let mut fe = file_ext;
                        if fe.starts_with(".") {
                            fe = fe.slice_chars(1, fe.char_len());
                        }
                        let ext_skip = ext != "" && fe != ext;
                        if !is_dir && !has_prefix && !ext_skip {
                            let new_name = prefix + clean;
                            let old_path = std.path.join(dir, clean);
                            let new_path = std.path.join(dir, new_name);

                            // 同名冲突守卫(审计修复):rename 落到已存在目标会静默覆盖
                            // (实测数据丢失)——目标存在即拒绝,计入失败,原文件保留
                            if std.fs.exists(new_path) {
                                eprint("batch_rename: 失败: \{clean}: 目标已存在,拒绝覆盖: \{new_name}");
                                failed += 1;} else {

                                match std.fs.rename(old_path, new_path) {
                                    Ok(_) => {
                                        print("重命名: \{clean} -> \{new_name}");
                                        count += 1;
                                    },
                                    Err(e) => {
                                        eprint("batch_rename: 失败: \{clean}: \{e}");
                                        failed += 1;
                                    },
                                }
                            }
                        }
                    },
                    Err(_) => {

                        // 污条目不能作路径(含控制字符等)——按失败计,不中断其余条目
                        failed += 1;
                    },
                }
            }
        },
        Err(e) => {
            eprint("batch_rename: 无法读取目录 \{dir}: \{e}");
            failed += 1;
        },
    }
    return (count, failed);
}

// v0.82 污点迁移(ADR-008):argv 元素级污点(main 参数 Vec[Untrusted[str]])——逐元素
// 过 std.unstr.sanitize_cli_path(校验不改写:拒控制字符,Ok 原样)取净值(目录路径位 +
// 前缀/扩展名匹配串);空串参数原样保留(迁移前语义:空 dir/prefix/ext → env 回退)。
// 良性路径行为与迁移前逐字节一致。
fn main(raw_args: Vec[Untrusted[str]]) -> i64 with io, fs, env {
    let mut args: Vec[str] = [];
    for a in raw_args {
        if a.is_empty() {
            args.push("");} else {
            match std.unstr.sanitize_cli_path(a) {
                Ok(p) => {
                    args.push(p);
                },
                Err(e) => {
                    eprint("batch_rename: " + e);
                    return 1;
                },
            }
        }
    }

    // v0.45.1 检视修正:批量重命名是破坏性操作——目录必须显式给出(args 优先,env 回退),
    // 不再默认 "."(此前在仓库误运行会把当前目录文件全部改名)
    let mut dir = "";
    let mut prefix = "";
    let mut ext = "";
    if args.len() >= 1 {
        dir = args[0];
    }
    if args.len() >= 2 {
        prefix = args[1];
    }
    if args.len() >= 3 {
        ext = args[2];
    }
    if dir == "" {
        match std.env.get("RENAME_DIR") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        dir = p;
                    },
                    Err(e) => {
                        eprint("RENAME_DIR: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    if prefix == "" {
        match std.env.get("RENAME_PREFIX") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        prefix = p;
                    },
                    Err(e) => {
                        eprint("RENAME_PREFIX: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    if ext == "" {
        match std.env.get("RENAME_EXT") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        ext = p;
                    },
                    Err(e) => {
                        eprint("RENAME_EXT: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }

    // 扩展名归一化(审计修复):接受 "txt" 与 ".txt" 两种写法——此前只有 ".txt"
    // 生效,"txt" 静默零改名 exit 0;F5(NOTE-3):"." 归一化后为空串,扩展名过滤整体
    // 失效(ext_skip 恒 false → 全部文件被改名)——输入非空而归一化后为空 = 具名
    // 拒绝,不静默
    let raw_ext = ext;
    if ext.starts_with(".") {
        ext = ext.slice_chars(1, ext.char_len());
    }
    if dir == "" || prefix == "" {
        eprint("用法: node bin/ming.js run tools/batch_rename.ming -- <目录> <前缀> [扩展名]");
        eprint("  (也可用环境变量 RENAME_DIR / RENAME_PREFIX / RENAME_EXT)");
        eprint("  幂等:文件名已带前缀的跳过;扩展名过滤 txt/.txt 均可;同名目标拒绝覆盖;存在失败时退出码 1");
        return 1;
    }
    if ext == "" && raw_ext != "" {
        eprint("batch_rename: 扩展名 \"" + raw_ext + "\" 归一化后为空(会使扩展名过滤整体失效;只接受 txt/.txt 形态),拒绝执行");
        return 1;
    }
    print("目录: \{dir}, 前缀: \{prefix}, 扩展名过滤: \{ext}");
    let (total, failed) = batch_rename(dir, prefix, ext, 0, 0);
    print("共重命名 \{total} 个文件");
    if failed > 0 {
        eprint("batch_rename: \{failed} 个失败");
        return 1;
    }
    return 0;
}
