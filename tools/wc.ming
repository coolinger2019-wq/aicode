// tools/wc.ming — 行/词/字节统计(用 Ming 自写;Unix wc 口径)
//
// v0.51.6 优化:多文件支持(多文件时末尾附 total 行,与 Unix 一致;
// 单文件保持旧行数不附加)+ 错误纪律(读不了的文件走 stderr 并计入失败,
// 退出码 1,不中断其余文件)。单文件输出格式与 v0.45.1 完全一致。
//
// v0.77 污点迁移(ADR-007):read_file → Untrusted[str];行/字节计数走污值代数
// clean 面(split/ends_with/byte_len,输出计数净值);词计数由 re.split("\\s+")
// 改为等价的保污扫描(count_words——re 的 pattern/内容槽是净槽,污内容不可入;
// 词 = 极大非空白连续段数,is_space 与 \\s 同为 JS \s 口径,语义逐字节等价)。
//
// 用法:node bin/ming.js run tools/wc.ming -- <file...>
//   输出:行 词 字节 <路径>(多文件时追加:行 词 字节 total)
use std.fs;

// 词计数:非空白字符段的个数(与 re.split("\\s+") 的段数等价;
// 空白判定 is_space = JS \s,与 \\s+ 同口径;纯函数,输出计数净)
fn count_words(s: Untrusted[str]) -> i64 {
    let mut words = 0;
    let mut in_word = false;
    for ch in s.chars() {
        if ch.is_space() {
            in_word = false;} else {

            if !in_word {
                words += 1;
            }
            in_word = true;
        }
    }
    return words;
}

// 返回 (行, 词, 字节) 或 Err(消息)
fn count_file(path: str) -> Result[(i64, i64, i64), str] with fs {
    match std.fs.read_file(path) {
        Ok(content) => {
            let lines = content.split("\n");
            let mut line_count = lines.len();
            if content.ends_with("\n") {
                line_count -= 1;
            }
            if line_count < 0 {
                line_count = 0;
            }
            let trimmed = content.trim();
            let mut word_count = 0;
            if !trimmed.is_empty() {
                word_count = count_words(trimmed);
            }
            return Ok((line_count, word_count, content.byte_len()));
        },
        Err(e) => {
            return Err(e);
        },
    }
}

// v0.82 污点迁移(ADR-008):argv 元素级污点(main 参数 Vec[Untrusted[str]])——逐元素
// 过 std.unstr.sanitize_cli_path(校验不改写:拒控制字符,Ok 原样)取净值作路径;
// 空串参数原样保留(迁移前语义:空路径进列表,读取时失败)。良性路径行为与
// 迁移前逐字节一致。
fn main(raw_args: Vec[Untrusted[str]]) -> i64 with io, fs, env {
    let mut args: Vec[str] = [];
    for a in raw_args {
        if a.is_empty() {
            args.push("");} else {
            match std.unstr.sanitize_cli_path(a) {
                Ok(p) => {
                    args.push(p);
                },
                Err(e) => {
                    eprint("wc: " + e);
                    return 1;
                },
            }
        }
    }

    // 兼容旧用法:无参数时回退环境变量 WC_FILE
    // 值语义:拿到的是深拷贝
    let mut files = args;
    if files.len() == 0 {
        match std.env.get("WC_FILE") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        files.push(p);
                    },
                    Err(e) => {
                        eprint("WC_FILE: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    if files.len() == 0 {
        eprint("用法: node bin/ming.js run tools/wc.ming -- <文件...>(或环境变量 WC_FILE)");
        return 1;
    }
    let mut failed = 0;
    let mut t_lines: i64 = 0;
    let mut t_words: i64 = 0;
    let mut t_bytes: i64 = 0;
    for f in files {
        match count_file(f) {
            Ok(t) => {
                let (lc, wc, bc) = t;
                print("\{lc} \{wc} \{bc} \{f}");
                t_lines += lc;
                t_words += wc;
                t_bytes += bc;
            },
            Err(e) => {
                eprint("wc: 无法读取 \{f}: \{e}");
                failed += 1;
            },
        }
    }
    if files.len() > 1 {
        print("\{t_lines} \{t_words} \{t_bytes} total");
    }
    if failed > 0 {
        return 1;
    }
    return 0;
}
