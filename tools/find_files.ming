// tools/find_files.ming — 按名查找文件(用 Ming 自写;递归)
//
// v0.51.6 优化:错误纪律(读不了的目录走 stderr 并计入失败,存在失败退出码 1)。
// 跳过隐藏目录与 node_modules 的行为不变。
//
// 用法:node bin/ming.js run tools/find_files.ming -- <目录> <文件名子串>
//   (也可用环境变量 FIND_ROOT / FIND_NAME)
use std.fs;

use std.path;

// 返回 (命中数, 失败数)
fn find(dir: str, needle: str, mut count: i64, mut failed: i64) -> (i64, i64) with io, fs {
    match std.fs.list_dir(dir) {
        Ok(entries) => {
            for name in entries {
                let full = std.path.join(dir, name);
                if std.fs.is_dir(full) {
                    if name.starts_with(".") {
                        continue;
                    }
                    if name == "node_modules" {
                        continue;
                    }
                    let (c, f) = find(full, needle, count, failed);
                    count = c;
                    failed = f;} else {

                    if name.contains(needle) {
                        print(full);
                        count += 1;
                    }
                }
            }
        },
        Err(e) => {
            eprint("find_files: 无法读取 \{dir}: \{e}");
            failed += 1;
        },
    }
    return (count, failed);
}

fn main(args: Vec[str]) -> i64 with io, fs, env {
    let mut root = ".";
    let mut needle = "";
    if args.len() >= 1 {
        root = args[0];
    }
    if args.len() >= 2 {
        needle = args[1];
    }
    if root == "" {
        match std.env.get("FIND_ROOT") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        root = p;
                    },
                    Err(e) => {
                        eprint("FIND_ROOT: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    if needle == "" {
        match std.env.get("FIND_NAME") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        needle = p;
                    },
                    Err(e) => {
                        eprint("FIND_NAME: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    if needle == "" {
        eprint("用法: node bin/ming.js run tools/find_files.ming -- <目录> <文件名子串>(或 FIND_ROOT / FIND_NAME)");
        return 1;
    }
    print("在 \{root} 中查找包含 \"\{needle}\" 的文件名:");
    let (total, failed) = find(root, needle, 0, 0);
    print("共找到 \{total} 个");
    if failed > 0 {
        eprint("find_files: \{failed} 个目录读取失败");
        return 1;
    }
    return 0;
}
