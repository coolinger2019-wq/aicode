use std.fs;
use std.path;

fn find(dir: str, needle: str, mut count: i64) -> i64 with io, fs {
    match std.fs.list_dir(dir) {
        Ok(entries) => {
            for name in entries {
                let full = std.path.join(dir, name);
                if std.fs.is_dir(full) {
                    if name.starts_with(".") { continue; }
                    if name == "node_modules" { continue; }
                    count = find(full, needle, count);
                } else {
                    if name.contains(needle) {
                        print(full);
                        count += 1;
                    }
                }
            }
        }
        Err(e) => {
            print("无法读取 \{dir}: \{e}");
        }
    }
    return count;
}

fn main(args: Vec[str]) -> i64 with io, fs, env {
    let mut root = ".";
    let mut needle = "";
    if args.len() >= 1 { root = args[0]; }
    if args.len() >= 2 { needle = args[1]; }
    if root == "" { match std.env.get("FIND_ROOT") { Some(v) => { root = v; } None => { } } }
    if needle == "" { match std.env.get("FIND_NAME") { Some(v) => { needle = v; } None => { } } }
    if needle == "" {
        print("用法: node bin/ming.js run tools/find_files.ming -- <目录> <文件名子串>(或 FIND_ROOT / FIND_NAME)");
        return 1;
    }
    print("在 \{root} 中查找包含 \"\{needle}\" 的文件名:");
    let total = find(root, needle, 0);
    print("共找到 \{total} 个");
    return 0;
}