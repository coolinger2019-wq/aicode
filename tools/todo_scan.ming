// tools/todo_scan.ming — 待办标记扫描(用 Ming 自写;递归)
//
// v0.51.6 优化:错误纪律(读不了的目录走 stderr 并计入失败,存在失败退出码 1)
// + 扫描扩展名补充 .mjs/.cjs(此前 tests/run.mjs 这类文件不在覆盖面)。
//
// 用法:node bin/ming.js run tools/todo_scan.ming -- <目录>
//   (也可用环境变量 TODO_SCAN_ROOT)
//
// v0.77 污点迁移(ADR-007):list_dir 条目 → Vec[Untrusted[str]],read_file →
// Untrusted[str]——条目先过 std.unstr.sanitize_cli_path(校验不改写:拒控制字符,
// Ok 原样)再作路径/比较串,不可作路径的条目计入失败;行内容沿污值代数保污链
// 处理,TODO|FIXME|XXX|HACK 正则改写为逐 contains(固定串,与无锚点 alternation
// 逐字节等价),命中行经 print 出向透传回显。良性路径行为与迁移前逐字节一致。
use std.fs;

use std.path;

const SCAN_EXTS: Vec[str] = [".ming", ".js", ".mjs", ".cjs", ".ts", ".md", ".py", ".go", ".rs"];

fn is_scan_target(name: str) -> bool {
    let ext = std.path.extension(name);
    for e in SCAN_EXTS {
        if ext == e {
            return true;
        }
    }
    return false;
}

// 返回 (命中数, 失败数)
fn scan_dir(dir: str, mut count: i64, mut failed: i64) -> (i64, i64) with io, fs {
    match std.fs.list_dir(dir) {
        Ok(entries) => {
            for name in entries {
                match std.unstr.sanitize_cli_path(name) {
                    Ok(clean) => {
                        let full = std.path.join(dir, clean);
                        if std.fs.is_dir(full) {

                            // 跳过隐藏目录与 node_modules/dist
                            if !clean.starts_with(".") && clean != "node_modules" && clean != "dist" {
                                let (c, f) = scan_dir(full, count, failed);
                                count = c;
                                failed = f;
                            }} else if is_scan_target(clean) {

                            let (c, f) = scan_file(full, count, failed);
                            count = c;
                            failed = f;
                        }
                    },
                    Err(_) => {

                        // 污条目不能作路径(含控制字符等)——按失败计,不中断其余条目
                        failed += 1;
                    },
                }
            }
        },
        Err(e) => {
            eprint("todo_scan: 无法读取目录 \{dir}: \{e}");
            failed += 1;
        },
    }
    return (count, failed);
}

// 返回 (命中数, 失败数)
fn scan_file(path: str, mut count: i64, mut failed: i64) -> (i64, i64) with io, fs {
    match std.fs.read_file(path) {
        Ok(content) => {
            let lines = content.split("\n");
            let mut i = 0;
            let n = lines.len();
            while i < n {
                let line = lines[i];

                // v0.77:污行不可入 re 净槽——固定串与 (TODO|FIXME|XXX|HACK)
                // 无锚点 alternation 逐字节等价;回显走拼接 + print 出向透传
                if line.contains("TODO") || line.contains("FIXME") || line.contains("XXX") || line.contains("HACK") {
                    print(path + ":" + str(i + 1) + ": " + line.trim());
                    count += 1;
                }
                i += 1;
            }
        },
        Err(e) => {
            eprint("todo_scan: 无法读取 \{path}: \{e}");
            failed += 1;
        },
    }
    return (count, failed);
}

// v0.82 污点迁移(ADR-008):argv 元素级污点(main 参数 Vec[Untrusted[str]])——逐元素
// 过 std.unstr.sanitize_cli_path(校验不改写:拒控制字符,Ok 原样)取净值作路径;
// 空串参数原样保留(迁移前语义:空 root → TODO_SCAN_ROOT 回退)。良性路径行为
// 与迁移前逐字节一致。
fn main(raw_args: Vec[Untrusted[str]]) -> i64 with io, fs, env {
    let mut args: Vec[str] = [];
    for a in raw_args {
        if a.is_empty() {
            args.push("");} else {
            match std.unstr.sanitize_cli_path(a) {
                Ok(p) => {
                    args.push(p);
                },
                Err(e) => {
                    eprint("todo_scan: " + e);
                    return 1;
                },
            }
        }
    }
    let mut root = ".";

    // args 优先,环境变量 TODO_SCAN_ROOT 回退
    if args.len() >= 1 {
        root = args[0];
    }
    if root == "" {
        match std.env.get("TODO_SCAN_ROOT") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        root = p;
                    },
                    Err(e) => {
                        eprint("TODO_SCAN_ROOT: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    print("扫描目录: \{root}");
    let (total, failed) = scan_dir(root, 0, 0);
    print("共发现 \{total} 处待办标记");
    if failed > 0 {
        eprint("todo_scan: \{failed} 个路径读取失败");
        return 1;
    }
    return 0;
}
