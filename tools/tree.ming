// tools/tree.ming — 目录树(用 Ming 自写;递归)
//
// v0.51.6 优化:可选深度参数(缺省不限)+ 错误纪律(读不了的目录走 stderr
// 并计入失败,存在失败退出码 1)。跳过隐藏目录与 node_modules/dist 不变;
// 计数口径不变(打印过的条目数,含目录)。
//
// 用法:node bin/ming.js run tools/tree.ming -- <目录> [深度]
//   (也可用环境变量 TREE_ROOT;深度 1 = 只看顶层)
//
// v0.77 污点迁移(ADR-007):list_dir 条目 → Vec[Untrusted[str]]——每个条目先过
// std.unstr.sanitize_cli_path(校验不改写:拒控制字符,Ok 原样)再作路径/比较串;
// 含控制字符等不可作路径的条目计入失败(错误走 stderr 纪律)。良性路径行为与
// 迁移前逐字节一致。
use std.fs;

use std.path;

// 返回 (条目数, 失败数);depth 从 1 起,maxdepth <= 0 表示不限
fn print_tree(dir: str, prefix: str, depth: i64, maxdepth: i64, mut count: i64, mut failed: i64) -> (i64, i64) with io, fs {
    if maxdepth > 0 && depth > maxdepth {
        return (count, failed);
    }
    match std.fs.list_dir(dir) {
        Ok(entries) => {
            let mut i = 0;
            let n = entries.len();
            while i < n {
                let name = entries[i];
                match std.unstr.sanitize_cli_path(name) {
                    Ok(clean) => {
                        let full = std.path.join(dir, clean);
                        let is_last = i == n - 1;
                        let branch = if is_last { "└── " } else { "├── " };
                        print("\{prefix}\{branch}\{clean}");
                        count += 1;
                        if std.fs.is_dir(full) {
                            if !clean.starts_with(".") && clean != "node_modules" && clean != "dist" {
                                let next_prefix = if is_last { prefix + "    " } else { prefix + "│   " };
                                let (c, f) = print_tree(full, next_prefix, depth + 1, maxdepth, count, failed);
                                count = c;
                                failed = f;
                            }
                        }
                    },
                    Err(_) => {

                        // 污条目不能作路径(含控制字符等)——按失败计,不中断其余条目
                        failed += 1;
                    },
                }
                i += 1;
            }
        },
        Err(e) => {
            eprint("tree: \{prefix}[无法读取 \{dir}: \{e}]");
            failed += 1;
        },
    }
    return (count, failed);
}

// v0.82 污点迁移(ADR-008):argv 元素级污点(main 参数 Vec[Untrusted[str]])——逐元素
// 过 std.unstr.sanitize_cli_path(校验不改写:拒控制字符,Ok 原样)取净值;空串参数
// 原样保留(迁移前语义:空 root → TREE_ROOT 回退/空深度 → 解析失败)。良性路径
// 行为与迁移前逐字节一致。
fn main(raw_args: Vec[Untrusted[str]]) -> i64 with io, fs, env {
    let mut args: Vec[str] = [];
    for a in raw_args {
        if a.is_empty() {
            args.push("");} else {
            match std.unstr.sanitize_cli_path(a) {
                Ok(p) => {
                    args.push(p);
                },
                Err(e) => {
                    eprint("tree: " + e);
                    return 1;
                },
            }
        }
    }
    let mut root = ".";

    // 0 = 不限
    let mut maxdepth: i64 = 0;
    if args.len() >= 1 {
        root = args[0];
    }
    if args.len() >= 2 {
        match args[1].parse_i64() {
            Ok(n) => {
                if n < 1 {
                    eprint("tree: 深度必须是正整数,得到 " + args[1]);
                    return 1;
                }
                maxdepth = n;
            },
            Err(_) => {
                eprint("tree: 深度不是整数: " + args[1]);
                return 1;
            },
        }
    }
    if root == "" {
        match std.env.get("TREE_ROOT") {
            Some(v) => {
                match std.unstr.sanitize_cli_path(v) {
                    Ok(p) => {
                        root = p;
                    },
                    Err(e) => {
                        eprint("TREE_ROOT: " + e);
                        return 1;
                    },
                }
            },
            None => {
            },
        }
    }
    print(root);
    let (total, failed) = print_tree(root, "", 1, maxdepth, 0, 0);
    print("\n共 \{total} 个条目");
    if failed > 0 {
        eprint("tree: \{failed} 个目录读取失败");
        return 1;
    }
    return 0;
}
