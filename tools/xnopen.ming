// tools/xnopen.ming — xn-- SNI 改写:自动探测 + Chrome 启动(gfw.report CCS 2026 §4.3 CircumVolve)
//
// 论文方法:SNI 改成 xn--+ASCII 十六进制(伪 IDN),绕过原始字符串匹配型域名黑名单;
// 配合真实主机映射 + Host 头把请求落到源站。
//
// 本工具的三段行为:
//   1) 改写:同 xnsni(论文示例向量逐字)
//   2) 探测:curl 全配方(SNI 改写 + --connect-to 映射 + Host 头)对比原 URL 的 HTTP 响应码,
//      给出"本方法是否可通过"的自动判定
//   3) Chrome 启动:用 --host-resolver-rules 映射(SNI 自动=改写后的主机名)+ 跳过证书校验。
//      硬限制:Chrome 无法改写 Host 头(永远等于 URL 主机)==> 只有不校验 Host 的服务器才可能
//      显示内容;Cloudflare 边沿实测 403(服务器拒未知 Host,非本工具问题)。
//
// 用法:node bin/ming.js tools xnopen <url> [--no-chrome] [--chrome=<路径>]
//   --no-chrome   只探测,不启动浏览器
//   --chrome=...  指定 Chrome 可执行文件(默认 Windows 标准安装路径)
use std.str;

fn hex_digit(d: i64) -> str {
    let table = "0123456789abcdef";
    return table.slice_chars(d, d + 1);
}

fn hex_encode(s: str) -> str {
    let mut out = "";
    for b in s.to_bytes() {
        let v = b.to_i64().unwrap_or(0);
        out = out + hex_digit(v / 16) + hex_digit(v % 16);
    }
    return out;
}

// 跑 curl 拿 HTTP 响应码;任何失败(连不上/超时/非零退出)记 0
fn curl_code(cargs: Vec[str]) -> i64 with proc {
    match std.proc.exec("curl", cargs) {
        Ok(t) => {
            let (_code, out, _err) = t;
            match out.parse_i64() {
                Ok(n) => {
                    return n;
                },
                Err(_) => {
                    return 0;
                },
            }
        },
        Err(_) => {
            return 0;
        },
    }
}

fn base_curl_args() -> Vec[str] {
    return ["-sSk", "--noproxy", "*", "--max-time", "8", "-o", "NUL", "-w", "%{http_code}"];
}

fn usage() with io {
    eprint("用法: node bin/ming.js tools xnopen <url> [--no-chrome] [--chrome=<路径>]\n  例: node bin/ming.js tools xnopen https://cloudflare.com/ping\n");
}

fn main(args: Vec[str]) -> i64 with io, proc {
    if args.is_empty() {
        usage();
        return 1;
    }
    let mut url = "";
    let mut no_chrome = false;
    let mut chrome_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe";
    for a in args {
        if a == "--no-chrome" {
            no_chrome = true;} else if a.starts_with("--chrome=") {

            chrome_path = a.slice_chars(9, a.char_len());} else if !a.starts_with("--") && url == "" {

            url = a;
        }
    }
    if url == "" {
        usage();
        return 1;
    }
    let mut scheme = "https";
    let mut rest = url;
    match str.index_of(url, "://") {
        Some(i) => {
            scheme = url.slice_chars(0, i);
            rest = url.slice_chars(i + 3, url.char_len());
        },
        None => {
        },
    }
    let segs = rest.split("/");
    let hostport = segs.get(0).unwrap_or("");
    if hostport.is_empty() || hostport.contains("@") {
        eprint("error: 主机名无效(空或含 userinfo)\n");
        return 1;
    }
    let hp = hostport.split(":");
    if hp.len() > 2 {
        eprint("error: IPv6 形态暂不支持\n");
        return 1;
    }
    let mut host = hostport;
    let mut port = "443";
    if scheme == "http" {
        port = "80";
    }
    if hp.len() == 2 {
        host = hp.get(0).unwrap_or("");
        port = hp.get(1).unwrap_or("443");
    }
    let mut tail: Vec[str] = [];
    let mut i = 1;
    while i < segs.len() {
        match segs.get(i) {
            Some(p) => {
                tail.push(p);
            },
            None => {
            },
        }
        i += 1;
    }
    let mut path = "/";
    if tail.len() > 0 {
        path = "/" + tail.join("/");
    }
    let sni = "xn--" + hex_encode(host);
    let rew_url = scheme + "://" + sni + path;
    print("== 改写 ==");
    print("sni:  " + sni);
    print("url:  " + rew_url);

    // 探测:原 URL vs 全配方(SNI 改写 + connect-to + Host)
    let mut oargs = base_curl_args();
    oargs.push(url);
    let orig = curl_code(oargs);
    let mut rargs = base_curl_args();
    rargs.push("--connect-to");
    rargs.push(sni + ":" + port + ":" + host + ":" + port);
    rargs.push("-H");
    rargs.push("Host: " + host);
    rargs.push(rew_url);
    let rew = curl_code(rargs);
    print("== 探测(curl 全配方) ==");
    print("原 URL:  " + str(orig));
    print("改写后:  " + str(rew));
    if rew == 0 {
        print("判定: 改写不可达——服务器不宽容伪 IDN SNI,或站点属 DNS/IP 层封锁(本方法无效)");} else if orig == 0 {

        print("判定: 原站不可达但改写可达——关键字匹配型过滤场景下本方法有效");} else if orig == rew {

        print("判定: 可通过——改写后响应码与原 URL 一致");} else {

        print("判定: 疑似可通过——响应码不同(原=" + str(orig) + " 改写=" + str(rew) + ")");
    }
    print("== Chrome ==");
    if no_chrome {
        print("skipped(--no-chrome)");
        return 0;
    }

    // Chrome 近似路径:--host-resolver-rules 把改写主机名映射到真实主机(SNI 自动=改写名);
    // 独立 user-data-dir 强制新实例使旗标生效;--ignore-certificate-errors 跳过证书名校验。
    let mut cargs: Vec[str] = ["/c", "start", "", chrome_path, "--user-data-dir=%TEMP%\\ming-xnopen", "--ignore-certificate-errors"];
    cargs.push("--host-resolver-rules=MAP " + sni + " " + host);
    cargs.push(rew_url);
    match std.proc.exec("cmd", cargs) {
        Ok(_) => {
            print("已启动 Chrome(" + chrome_path + ")");
            print("注意: Chrome 无法改写 Host 头(硬限制)——仅不校验 Host 的服务器可能显示内容;Cloudflare 边沿实测 403");
        },
        Err(e) => {
            eprint("error: Chrome 启动失败(" + e + ");用 --chrome=<路径> 指定 chrome.exe\n");
            return 1;
        },
    }
    return 0;
}
