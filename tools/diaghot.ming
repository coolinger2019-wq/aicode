// tools/diaghot.ming — 诊断热力图(用 Ming 自写,v0.44;仓库第三个自举工具)
//
// 动机(Jenny 的"错误码热力图驱动语言进化"):Ming 有稳定诊断码 + 模糊器,
// 但缺"哪些码在真实代码里高频"的数据。diaghot 跑 ming check --json 并聚合,
// 让语法/检查的改进有数据依据。
//
// 用法:node bin/ming.js run tools/diaghot.ming -- <file.ming...>

use std.proc;
use std.json;

const NODE: str = "node";
const MING: str = "bin/ming.js";

// Json 可选字段读取(缺键/类型不符都给默认)
fn jstr(j: Json, key: str, dflt: str) -> str {
    match j.get(key) {
        Some(v) => {
            match v.as_str() {
                Some(s) => { return s; }
                None => { return dflt; }
            }
        }
        None => { return dflt; }
    }
}

fn main(args: Vec[str]) -> i64 with io, proc {
    if args.len() < 1 {
        eprint("diaghot — 诊断热力图(用 Ming 自写)");
        eprint("用法: node bin/ming.js run tools/diaghot.ming -- <file.ming...>");
        return 1;
    }
    // 一次 check 全部文件(--json 输出单个合并对象)
    let mut cmd: Vec[str] = [MING, "check"];
    for f in args {
        cmd.push(f);
    }
    cmd.push("--json");
    let out = match std.proc.exec(NODE, cmd) {
        Ok(t) => {
            let (code, o, err) = t;
            if code < 0 {
                eprint("diaghot: check 进程异常: " + err);
                return 1;
            }
            o
        }
        Err(e) => {
            eprint("diaghot: exec 失败: " + e);
            return 1;
        }
    };
    let doc = match std.json.parse(out) {
        Ok(j) => j,
        Err(e) => {
            eprint("diaghot: 输出不是合法 JSON: " + e);
            return 1;
        }
    };
    let mut diags: Vec[Json] = [];
    match doc.get("diagnostics") {
        Some(d) => {
            match d.as_arr() {
                Some(arr) => { diags = arr; }
                None => {},
            }
        }
        None => {},
    }
    // 聚合:码 → 次数 / 文件列表 / 首条消息
    let mut counts: Map[str, i64] = [:];
    let mut files: Map[str, Vec[str]] = [:];
    let mut sample: Map[str, str] = [:];
    for d in diags {
        let code = jstr(d, "code", "?");
        counts.set(code, counts.get(code).unwrap_or(0) + 1);
        let f = jstr(d, "file", "?");
        let mut fl: Vec[str] = [];
        match files.get(code) {
            Some(v) => { fl = v; }
            None => {},
        }
        if !fl.contains(f) {
            fl.push(f);
        }
        files.set(code, fl);
        match sample.get(code) {
            Some(_) => {},
            None => {
                sample.set(code, jstr(d, "message", ""));
            }
        }
    }
    let n = diags.len();
    let nfiles = args.len();
    print("诊断热力图:" + str(nfiles) + " 个文件," + str(n) + " 条诊断," + str(counts.len()) + " 种码");
    if counts.len() == 0 {
        print("(干净)");
        return 0;
    }
    // 选择排序输出(码数少,O(n^2) 足够)
    let mut remaining: Vec[str] = [];
    for k in counts.keys() {
        remaining.push(k);
    }
    let mut rank = 1;
    while remaining.len() > 0 {
        let mut bi = 0;
        let mut i = 1;
        while i < remaining.len() {
            if counts.get(remaining[i]).unwrap_or(0) > counts.get(remaining[bi]).unwrap_or(0) {
                bi = i;
            }
            i = i + 1;
        }
        let code = remaining[bi];
        let mut rest: Vec[str] = [];
        let mut j = 0;
        while j < remaining.len() {
            if j != bi {
                rest.push(remaining[j]);
            }
            j = j + 1;
        }
        remaining = rest;
        let cnt = counts.get(code).unwrap_or(0);
        let mut nf = 0;
        match files.get(code) {
            Some(v) => { nf = v.len(); }
            None => {},
        }
        print("  " + str(rank) + ". " + code + "  x" + str(cnt) + "  (" + str(nf) + " 个文件)");
        let m = match sample.get(code) {
            Some(s) => s,
            None => "",
        };
        if m != "" {
            print("     " + m);
        }
        rank = rank + 1;
    }
    return 0;
}
