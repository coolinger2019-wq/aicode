// tools/log_analyzer.ming — 日志行计数(用 Ming 自写)
//
// v0.51.6 优化:错误纪律(读不了文件走 stderr 并退出 1;此前 stdout + 退出 0)。
// 计数口径不变:含 ERROR/WARN/INFO 的行分类计数(一行命中多类时按此优先级),
// 末尾换行产生的空行不计。
//
// 用法:node bin/ming.js run tools/log_analyzer.ming -- <日志文件>
//   (也可用环境变量 LOG_FILE)
use std.fs;

fn analyze(path: str) -> i64 with io, fs {
    match std.fs.read_file(path) {
        Ok(content) => {
            let lines = content.split("\n");
            let mut errors = 0;
            let mut warns = 0;
            let mut infos = 0;
            let mut others = 0;
            let mut i = 0;
            let mut n = lines.len();

            // 末尾换行产生的空元素不算一行(与 wc 口径一致)
            if n > 0 && lines[n - 1] == "" {
                n = n - 1;
            }
            while i < n {
                let line = lines[i];
                if line.contains("ERROR") {
                    errors += 1;} else if line.contains("WARN") {

                    warns += 1;} else if line.contains("INFO") {

                    infos += 1;} else {
                    others += 1;
                }
                i += 1;
            }
            print("文件: \{path}");
            print("总行数: \{n}");
            print("ERROR: \{errors}");
            print("WARN:  \{warns}");
            print("INFO:  \{infos}");
            print("其他:  \{others}");
            return 0;
        },
        Err(e) => {
            eprint("log_analyzer: 无法读取 \{path}: \{e}");
            return 1;
        },
    }
}

fn main(args: Vec[str]) -> i64 with io, fs, env {
    let mut path = "";
    if args.len() >= 1 {
        path = args[0];
    }
    if path == "" {
        match std.env.get("LOG_FILE") {
            Some(v) => {
                path = v;
            },
            None => {
            },
        }
    }
    if path == "" {
        eprint("用法: node bin/ming.js run tools/log_analyzer.ming -- <日志文件>(或环境变量 LOG_FILE)");
        return 1;
    }
    return analyze(path);
}
