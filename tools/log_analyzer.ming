use std.fs;
use std.path;

fn analyze(path: str) with io, fs {
    match std.fs.read_file(path) {
        Ok(content) => {
            let lines = content.split("\n");
            let mut errors = 0;
            let mut warns = 0;
            let mut infos = 0;
            let mut others = 0;
            let mut i = 0;
            let mut n = lines.len();
            // 末尾换行产生的空元素不算一行(与 wc 口径一致)
            if n > 0 && lines[n - 1] == "" { n = n - 1; }
            while i < n {
                let line = lines[i];
                if line.contains("ERROR") { errors += 1; }
                else if line.contains("WARN") { warns += 1; }
                else if line.contains("INFO") { infos += 1; }
                else { others += 1; }
                i += 1;
            }
            print("文件: \{path}");
            print("总行数: \{n}");
            print("ERROR: \{errors}");
            print("WARN:  \{warns}");
            print("INFO:  \{infos}");
            print("其他:  \{others}");
        }
        Err(e) => {
            print("无法读取 \{path}: \{e}");
        }
    }
}

fn main(args: Vec[str]) -> i64 with io, fs, env {
    let mut path = "";
    if args.len() >= 1 { path = args[0]; }
    if path == "" { match std.env.get("LOG_FILE") { Some(v) => { path = v; } None => { } } }
    if path == "" {
        print("用法: node bin/ming.js run tools/log_analyzer.ming -- <日志文件>(或环境变量 LOG_FILE)");
        return 1;
    }
    analyze(path);
    return 0;
}